# Porta de execução da API
PORT=4000
NODE_ENV=development

# Configuração do PostgreSQL (Supabase)
# Para Supabase em produção (Render/Vercel):
# DATABASE_URL: Pooler mode (Transaction/pgbouncer) porta 6543
# DIRECT_URL: Direct connection porta 5432 (necessário para migrações do Prisma)
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# CORS Frontend URL (ex: https://meu-app.vercel.app ou http://localhost:5173 em dev)
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="sua-chave-secreta-jwt-super-segura"

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY="BJDykn01fgzJfhc1NwrdyLW6_LpALFiKcGX_Hpf8-v097INNMleEDgVJQMvZFDBJX7RdfplNw62Re_ZD-sPP5S4"
VAPID_PRIVATE_KEY="sua-chave-privada-vapid"
VAPID_SUBJECT="mailto:seu-email@dominio.com"

