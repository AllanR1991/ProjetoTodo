{
  "name": "todo-backend",
  "version": "1.0.0",
  "description": "Backend API para Microsoft To Do Clone com Express, Prisma e Supabase",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx src/test-suite.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "create-user": "tsx src/scripts/create-user.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "supabase",
    "todo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "imapflow": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.38",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
